# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này.
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật trong .env hoặc trên dashboard của platform
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
